# --- Database ---
# SQLite for local dev. For production Postgres, change provider in prisma/schema.prisma
# and set e.g. DATABASE_URL="postgresql://user:pass@host/db"
DATABASE_URL="file:./dev.db"

# --- Auth (admin login only — see /admin) ---
# Cuddler login/signup uses Clerk now (see Clerk section below). AUTH_SECRET is still used to
# sign the separate admin session cookie in lib/adminAuth.ts. Any long random string.
# Generate one: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Clerk (cuddler login/signup — https://dashboard.clerk.com > your app > API Keys) ---
# Use a SEPARATE Clerk application from findmemassage — this is a different business.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_..."
CLERK_SECRET_KEY="sk_..."

# --- Stripe (get from https://dashboard.stripe.com/test/apikeys) ---
# Use a SEPARATE Stripe account from findmemassage — Stripe requires one account per distinct
# business, and this is a different brand/entity even if you own both. See the chat where this
# was discussed for more on why (and a heads-up that "cuddle therapy" can draw extra scrutiny
# during underwriting since it's adjacent to Stripe's restricted-business list — being explicit
# that this is a non-sexual wellness service when you fill out the business description helps).
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Publishable key (safe to expose to the browser) — needed client-side to launch the Stripe
# Identity verification modal. Same dashboard page as the secret key above.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- Stripe Identity (automated government ID + live selfie check) ---
# Uses the same STRIPE_SECRET_KEY above — no separate key needed. Two things to do once in the
# Stripe dashboard before this works:
#   1. Make sure the "Identity" product is enabled for your account (Products > Identity).
#   2. Add these two event types to your webhook endpoint (Developers > Webhooks), alongside the
#      existing checkout/invoice/subscription events:
#        identity.verification_session.verified
#        identity.verification_session.requires_input
#        identity.verification_session.canceled
# Pricing: $1.50 per verification after the first 50 (free), as of mid-2026 — check
# https://stripe.com/pricing for current rates before launch.

# Subscription price IDs (create 2 recurring Prices in Stripe: $30/mo Standard, $60/mo VIP —
# per the pricing spec this site launched with).
STRIPE_PRICE_STANDARD="price_..."
STRIPE_PRICE_VIP="price_..."

# Agency plans (accountType === "agency" only, chosen at signup) — recurring monthly Prices in
# Stripe. Small Agency = 1-3 team members, Large Agency = 4-8. See AGENCY_EMPLOYEE_LIMITS in
# src/lib/config.ts. Pricing for these wasn't specified yet — set your own before launch.
STRIPE_PRICE_SMALL_AGENCY="price_..."
STRIPE_PRICE_LARGE_AGENCY="price_..."

# Boost credit packs (create one-time Prices). Format: priceId:credits, comma separated.
# Price these around $1-2 per credit — each credit is one 24-hour boost (BOOST_COOLDOWN_HOURS in
# src/lib/config.ts), so a 5-credit pack around $5-10 lands on the "$1-2/day" boost pricing.
STRIPE_CREDIT_PACKS="price_abc:5,price_def:12"

# --- Photo storage (S3-compatible object storage) ---
# Works unmodified with IONOS Object Storage, Cloudflare R2, or AWS S3 — pick one. Use a separate
# bucket from findmemassage's.
# S3_ENDPOINT examples:
#   IONOS Object Storage: https://s3.eu-central-3.ionoscloud.com
#   Cloudflare R2:        https://<account_id>.r2.cloudflarestorage.com
#   AWS S3:               https://s3.<region>.amazonaws.com
S3_ENDPOINT="https://s3.eu-central-3.ionoscloud.com"
S3_REGION="eu-central-3"
S3_BUCKET="findmecuddle-photos"
S3_ACCESS_KEY_ID="..."
S3_SECRET_ACCESS_KEY="..."
# Public base URL photos are served from — the bucket's public endpoint, or a CDN/custom domain in front of it.
S3_PUBLIC_URL_BASE="https://s3.eu-central-3.ionoscloud.com/findmecuddle-photos"

# --- Identity verification storage (separate PRIVATE bucket — do NOT reuse S3_BUCKET) ---
# Certification + government ID photos live here. This bucket must never have public access
# enabled (no "public dev URL" toggle, no public-read ACL, no CDN in front of it) — documents are
# only ever served through the admin-gated proxy at /api/admin/verification-image. Same account/
# credentials as above are fine; just create a second, separate bucket and point this at it.
S3_PRIVATE_BUCKET="findmecuddle-verification"

# --- Admin (moderation dashboard at /admin) ---
# Admin accounts (name, email, password, role) live in the database, not an env var — each
# person gets their own login. Create the first ("super") admin with:
#   npm run db:seed-admin
# It'll prompt you for a name, email, and password right in the terminal (nothing gets written
# to a file), then add teammates from the "Team" page at /admin/team once you're logged in.
# No env var needed here.

# --- Transactional email (Resend — https://resend.com, free tier works fine) ---
# Used for support/inquiry emails and the newsletter — no longer for password reset, Clerk
# handles that itself now. Without these set, emails just get logged to the server console.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Find Me Cuddle <onboarding@resend.dev>"

# --- Captcha (Cloudflare Turnstile — free, https://dash.cloudflare.com/?to=/:account/turnstile) ---
# Protects reviews, reports, contact, newsletter, and inquiry forms. No longer used on
# login/signup — Clerk has its own bot protection built in. Leave blank locally — the widget
# just won't render and the check is skipped. Set both before real launch.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- AI-generated photo detection (Sightengine — https://sightengine.com, free tier available) ---
# The detection code exists (lib/aiDetection.ts) but isn't wired into any upload route, same as
# findmemassage — automatic screening was turned off there in favor of manual admin flagging, and
# this app inherited that same setup. Leave blank; nothing to configure unless you decide to wire
# automatic screening back in.
SIGHTENGINE_API_USER=""
SIGHTENGINE_API_SECRET=""

# --- Site ---
NEXT_PUBLIC_SITE_NAME="Find Me Cuddle"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# In production set: NEXT_PUBLIC_SITE_URL="https://findmecuddle.com"

# --- Legal ---
# Contact address shown publicly on /privacy, /terms, and /faq. Consolidated to the same inbox as
# support (see NEXT_PUBLIC_SUPPORT_EMAIL below) rather than a separate privacy@ address. /privacy
# and /terms are still drafts and need attorney review before real launch — see README.
NEXT_PUBLIC_LEGAL_EMAIL="support@findmecuddle.com"
NEXT_PUBLIC_SUPPORT_EMAIL="support@findmecuddle.com"
